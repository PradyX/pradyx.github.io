{# --- Experience --- #}
<section class="experience-section" aria-labelledby="experience-heading">
  <h2 id="experience-heading" class="section-heading">Experience</h2>
  <ol class="timeline" aria-label="Work experience timeline">
    {% for exp in portfolio.experience %}
    <li class="timeline-item">
      <div class="timeline-header">
        <span class="timeline-role">{{ exp.role }}</span>
        <span class="timeline-dates" aria-label="Dates: {{ exp.dates }}">{{ exp.dates }}</span>
      </div>
      <p class="timeline-company">{{ exp.company }}{% if exp.company_url %} — <a href="{{ exp.company_url }}" target="_blank" rel="noopener noreferrer">{{ exp.company_url | replace('https://','') }}</a>{% endif %}</p>
      {% if exp.description %}
      <p class="timeline-desc">{{ exp.description | safe }}</p>
      {% endif %}
    </li>
    {% endfor %}
  </ol>
</section>

<style>
  .experience-section {
    padding: 2.5rem 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .timeline {
    padding: 0;
    margin: 0;
    list-style: none;
    max-width: 680px;
  }

  .timeline-item {
    position: relative;
    padding-left: 1.25rem;
    padding-bottom: 1.75rem;
    border-left: 2px solid var(--border);
    margin-left: 0.5rem;
  }

  .timeline-item:last-child {
    border-left: none;
    padding-bottom: 0;
  }

  .timeline-header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .timeline-role {
    font-size: 1rem;
    font-weight: 700;
    color: var(--fg);
  }

  .timeline-dates {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .timeline-company {
    font-size: 0.9375rem;
    color: var(--accent);
    margin: 0.25rem 0 0.5rem;
  }

  .timeline-company a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px dotted var(--accent);
  }

  .timeline-company a:hover {
    border-bottom-style: solid;
  }

  .timeline-desc {
    font-size: 0.9375rem;
    color: var(--fg);
    margin: 0;
    line-height: 1.6;
    white-space: pre-line;
  }
</style>
