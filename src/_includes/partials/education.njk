{# --- Education --- #}
<section class="education-section" aria-labelledby="education-heading">
  <h2 id="education-heading" class="section-heading">Education</h2>
  <ol class="timeline" aria-label="Education timeline">
    {% for edu in portfolio.education %}
    <li class="timeline-item">
      <div class="timeline-header">
        <span class="timeline-role">{{ edu.degree }}</span>
        <span class="timeline-dates" aria-label="Dates: {{ edu.dates }}">{{ edu.dates }}</span>
      </div>
      <p class="timeline-company">{{ edu.institution }}{% if edu.institution_url %} — <a href="{{ edu.institution_url }}" target="_blank" rel="noopener noreferrer">website</a>{% endif %}</p>
    </li>
    {% endfor %}
  </ol>
</section>

<style>
  .education-section {
    padding: 2.5rem 1.25rem;
    border-bottom: 1px solid var(--border);
  }
</style>
