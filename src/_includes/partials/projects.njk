{# --- Projects --- #}
<section class="projects-section" aria-labelledby="projects-heading">
  <h2 id="projects-heading" class="section-heading">Projects</h2>
  <ul class="project-list" aria-label="Projects list">
    {% for proj in portfolio.projects %}
    <li class="project-item">
      <div class="project-body">
        <h3 class="project-name">
          <a href="{{ proj.url }}" target="_blank" rel="noopener noreferrer">{{ proj.name }}</a>
        </h3>
        <p class="project-desc">{{ proj.description | safe }}</p>
        {% if proj.tech %}
        <p class="project-tech"><strong>Tech:</strong> {{ proj.tech | safe }}</p>
        {% endif %}
      </div>
    </li>
    {% endfor %}
  </ul>
</section>

<style>
  .projects-section {
    padding: 2.5rem 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .project-list {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 680px;
  }

  .project-item {
    padding: 1rem 0;
    border-top: 1px solid var(--border);
  }

  .project-item:first-child {
    border-top: none;
  }

  .project-body {
    padding-left: 1rem;
  }

  .project-name {
    font-size: 1.0625rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
  }

  .project-name a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease;
  }

  .project-name a:hover {
    border-bottom-color: var(--accent);
  }

  .project-desc {
    font-size: 0.9375rem;
    color: var(--fg);
    margin: 0 0 0.375rem;
    line-height: 1.6;
  }

  .project-tech {
    font-size: 0.8125rem;
    color: var(--muted);
    margin: 0;
  }
</style>
